---
layout: null
---
[
{% for post in site.posts %}
  { "title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "description": {{ post.description | default: '' | jsonify }}, "category": {{ post.categories | first | jsonify }}, "tags": {{ post.tags | jsonify }}, "date": {{ post.date | date: '%Y.%m.%d' | jsonify }}, "content": {{ post.content | strip_html | normalize_whitespace | truncate: 700 | jsonify }} }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
